{
  "info": {
    "name": "Performance Monitor Demo - RBAC",
    "description": "Run the Spring Boot app. Create local tokens with scripts/demo-token.ps1 for alice, bob, and ops; set the matching collection variables. User and endpoint roles come from the database. The token role claim does not grant access.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "Public timed endpoint - 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/demo/public",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "demo",
                "public"
              ]
            },
            "description": "No token required. The timing filter logs this annotated controller request."
          }
        }
      ]
    },
